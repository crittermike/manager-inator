{
  "name": "manager-inator",
  "productName": "Manager-inator",
  "version": "0.5.2",
  "main": "out/main/index.mjs",
  "scripts": {
    "postinstall": "node scripts/patch-electron-dev.mjs",
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "preview": "electron-vite preview",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "electron-vite build && playwright test",
    "test:fresh": "bash scripts/test-fresh.sh",
    "test:restore": "bash scripts/test-restore.sh",
    "dist": "electron-vite build && electron-builder --mac --publish never",
    "release": "electron-vite build && electron-builder --mac --publish always",
    "qa:search": "node scripts/qa-search.mjs"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "description": "AI-powered performance management desktop app for engineering managers",
  "build": {
    "appId": "com.manager-inator.app",
    "productName": "Manager-inator",
    "publish": [
      {
        "provider": "github",
        "owner": "crittermike",
        "repo": "manager-inator"
      }
    ],
    "mac": {
      "icon": "resources/icon.icns",
      "category": "public.app-category.productivity",
      "target": [
        "dmg",
        "zip"
      ],
      "artifactName": "${productName}-${version}-${arch}.${ext}"
    },
    "dmg": {
      "title": "Manager-inator"
    },
    "asarUnpack": [
      "node_modules/@github/copilot/**"
    ],
    "files": [
      "out/**",
      "resources/**",
      "package.json",
      "!node_modules/**/*.map",
      "!node_modules/**/*.ts",
      "!node_modules/**/*.tsx",
      "!node_modules/**/*.md",
      "!node_modules/**/*.txt",
      "!node_modules/**/*.d.ts",
      "!node_modules/**/LICENSE*",
      "!node_modules/**/CHANGELOG*",
      "!node_modules/**/README*",
      "!node_modules/**/.eslint*",
      "!node_modules/**/.prettier*",
      "!node_modules/**/test/**",
      "!node_modules/**/tests/**",
      "!node_modules/**/__tests__/**",
      "!node_modules/**/docs/**",
      "!node_modules/@types/**",
      "!node_modules/@tailwindcss/**",
      "!node_modules/@github/copilot/prebuilds/linux-*",
      "!node_modules/@github/copilot/prebuilds/win32-*",
      "!node_modules/date-fns/**",
      "!node_modules/lucide-react/**",
      "!node_modules/zod/**",
      "!node_modules/react/**",
      "!node_modules/react-dom/**",
      "!node_modules/react-router/**",
      "!node_modules/react-router-dom/**",
      "!node_modules/react-markdown/**",
      "!node_modules/remark-*/**",
      "!node_modules/rehype-*/**",
      "!node_modules/unified/**",
      "!node_modules/unist-*/**",
      "!node_modules/mdast-*/**",
      "!node_modules/micromark*/**",
      "!node_modules/hast-*/**",
      "!node_modules/property-information/**",
      "!node_modules/space-separated-tokens/**",
      "!node_modules/comma-separated-tokens/**",
      "!node_modules/character-entities*/**",
      "!node_modules/character-reference-invalid/**",
      "!node_modules/decode-named-character-reference/**",
      "!node_modules/devlop/**",
      "!node_modules/bail/**",
      "!node_modules/is-plain-obj/**",
      "!node_modules/trough/**",
      "!node_modules/vfile*/**",
      "!node_modules/tailwindcss/**",
      "!node_modules/@jridgewell/**",
      "!node_modules/enhanced-resolve/**",
      "!node_modules/tapable/**",
      "!node_modules/lightningcss/**",
      "!node_modules/scheduler/**",
      "!node_modules/ccount/**",
      "!node_modules/stringify-entities/**",
      "!node_modules/zwitch/**",
      "!node_modules/longest-streak/**",
      "!node_modules/dequal/**",
      "!node_modules/@ungap/**"
    ],
    "directories": {
      "output": "dist"
    }
  },
  "dependencies": {
    "@github/copilot": "^1.0.9",
    "@github/copilot-sdk": "^0.1.32",
    "@tailwindcss/vite": "^4.2.2",
    "date-fns": "^4.1.0",
    "electron-store": "^11.0.2",
    "electron-updater": "^6.8.3",
    "lucide-react": "^0.577.0",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "react-markdown": "^10.1.0",
    "react-router-dom": "^7.13.1",
    "remark-gfm": "^4.0.1",
    "yaml": "^2.8.3"
  },
  "devDependencies": {
    "@playwright/test": "^1.58.2",
    "@types/node": "^25.5.0",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^5",
    "@vitest/coverage-v8": "^3.2.4",
    "autoprefixer": "^10.4.27",
    "concurrently": "^9.2.1",
    "electron": "^41.1.0",
    "electron-builder": "^26.8.1",
    "electron-playwright-helpers": "^2.1.0",
    "electron-vite": "^5.0.0",
    "happy-dom": "^20.8.9",
    "playwright": "^1.58.2",
    "postcss": "^8.5.8",
    "sharp": "^0.34.5",
    "tailwindcss": "^4.2.2",
    "typescript": "^5.9.3",
    "vite": "^7",
    "vitest": "^3.2.4"
  }
}
